    -----------------------------------------------
    function Tab:AddButton(text, callback)
        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(1, 0, 0, 34)
        Btn.LayoutOrder = nextOrder()
        Btn.Text = text
        Btn.Font = Theme.Font
        Btn.AutoButtonColor = false
        Btn.Parent = Page
        registerColor(Btn, "BackgroundColor3", "ElementBG")
        registerColor(Btn, "TextColor3", "Text")
        corner(Btn, 8)
        stroke(Btn, "Accent", 1)
        registerText(Btn, 14)

        Btn.MouseEnter:Connect(function() tween(Btn, {BackgroundColor3 = Theme.AccentDark}) end)
        Btn.MouseLeave:Connect(function() tween(Btn, {BackgroundColor3 = Theme.ElementBG}) end)
        Btn.MouseButton1Click:Connect(function()
            playClick()
            tween(Btn, {BackgroundColor3 = Theme.Accent}, 0.08)
            task.delay(0.1, function() tween(Btn, {BackgroundColor3 = Theme.ElementBG}) end)
            if callback then callback() end
        end)
        return Btn
    end

    -----------------------------------------------
    function Tab:AddToggle(text, default, callback)
        local state = default or false

        local Holder = Instance.new("Frame")
        Holder.Size = UDim2.new(1, 0, 0, 34)
        Holder.LayoutOrder = nextOrder()
        Holder.Parent = Page
        registerColor(Holder, "BackgroundColor3", "ElementBG")
        corner(Holder, 8)

        local Label = Instance.new("TextLabel")
        Label.BackgroundTransparency = 1
        Label.Position = UDim2.new(0, 10, 0, 0)
        Label.Size = UDim2.new(1, -70, 1, 0)
        Label.Text = text
        Label.Font = Theme.FontRegular
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = Holder
        registerColor(Label, "TextColor3", "Text")
        registerText(Label, 13)

        local Switch = Instance.new("TextButton")
        Switch.Size = UDim2.new(0, 44, 0, 22)
        Switch.Position = UDim2.new(1, -54, 0.5, -11)
        Switch.BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(80, 80, 90)
        Switch.Text = ""
        Switch.AutoButtonColor = false
        Switch.Parent = Holder
        corner(Switch, 11)

        local Knob = Instance.new("Frame")
        Knob.Size = UDim2.new(0, 18, 0, 18)
        Knob.Position = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Knob.Parent = Switch
        corner(Knob, 9)

        local function refresh()
            tween(Switch, {BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(80, 80, 90)})
            tween(Knob, {Position = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)})
        end

        Switch.MouseButton1Click:Connect(function()
            playClick()
            state = not state
            refresh()
            if callback then callback(state) end
        end)

        return {
            Set = function(_, v) state = v; refresh(); if callback then callback(state) end end,
            Get = function() return state end
        }
    end

    -----------------------------------------------
    function Tab:AddSlider(text, min, max, default, callback)
        min, max = min or 0, max or 100
        local value = math.clamp(default or min, min, max)

        local Holder = Instance.new("Frame")
        Holder.Size = UDim2.new(1, 0, 0, 48)
        Holder.LayoutOrder = nextOrder()
        Holder.Parent = Page
        registerColor(Holder, "BackgroundColor3", "ElementBG")
        corner(Holder, 8)

        local Label = Instance.new("TextLabel")
        Label.BackgroundTransparency = 1
        Label.Position = UDim2.new(0, 10, 0, 4)
        Label.Size = UDim2.new(1, -70, 0, 18)
        Label.Text = text
        Label.Font = Theme.FontRegular
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = Holder
        registerColor(Label, "TextColor3", "Text")
        registerText(Label, 13)

        local ValueLabel = Instance.new("TextLabel")
        ValueLabel.BackgroundTransparency = 1
        ValueLabel.Position = UDim2.new(1, -60, 0, 4)
        ValueLabel.Size = UDim2.new(0, 50, 0, 18)
        ValueLabel.Text = tostring(value)
        ValueLabel.Font = Theme.Font
        ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
        ValueLabel.Parent = Holder
        registerColor(ValueLabel, "TextColor3", "Accent")
        registerText(ValueLabel, 13)

        local Track = Instance.new("Frame")
        Track.Position = UDim2.new(0, 10, 0, 28)
        Track.Size = UDim2.new(1, -20, 0, 8)
        Track.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        Track.Parent = Holder
        corner(Track, 4)

        local Fill = Instance.new("Frame")
        Fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        Fill.Parent = Track
        registerColor(Fill, "BackgroundColor3", "Accent")
        corner(Fill, 4)

        local Knob = Instance.new("TextButton")
        Knob.Size = UDim2.new(0, 16, 0, 16)
        Knob.Position = UDim2.new((value - min) / (max - min), -8, 0.5, -8)
        Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Knob.Text = ""
        Knob.Parent = Track
        corner(Knob, 8)

        local dragging = false
        Knob.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local rel = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                value = math.floor(min + rel * (max - min) + 0.5)
                Fill.Size = UDim2.new(rel, 0, 1, 0)
                Knob.Position = UDim2.new(rel, -8, 0.5, -8)
                ValueLabel.Text = tostring(value)
                if callback then callback(value) end
            end
        end)

        return {
            Set = function(_, v)
                value = math.clamp(v, min, max)
                local rel = (value - min) / (max - min)
                Fill.Size = UDim2.new(rel, 0, 1, 0)
                Knob.Position = UDim2.new(rel, -8, 0.5, -8)
                ValueLabel.Text = tostring(value)
                if callback then callback(value) end
            end,
            Get = function() return value end
        }
    end

    -----------------------------------------------
    function Tab:AddDropdown(text, options, callback)
        options = options or {}
        local open = false
        local selected = options[1]

        local Holder = Instance.new("Frame")
        Holder.Size = UDim2.new(1, 0, 0, 34)
        Holder.LayoutOrder = nextOrder()
        Holder.ClipsDescendants = true
        Holder.Parent = Page
        registerColor(Holder, "BackgroundColor3", "ElementBG")
        corner(Holder, 8)

        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(1, 0, 0, 34)
        Btn.BackgroundTransparency = 1
        Btn.Text = text .. ": " .. tostring(selected)
        Btn.Font = Theme.FontRegular
        Btn.Parent = Holder
        registerColor(Btn, "TextColor3", "Text")
        registerText(Btn, 13)

        local List = Instance.new("Frame")
        List.Position = UDim2.new(0, 0, 0, 34)
        List.Size = UDim2.new(1, 0, 0, #options * 26)
        List.BackgroundTransparency = 1
        List.Parent = Holder
        local ListLayout = Instance.new("UIListLayout")
        ListLayout.Parent = List

        for _, opt in ipairs(options) do
            local OptBtn = Instance.new("TextButton")
            OptBtn.Size = UDim2.new(1, 0, 0, 26)
            OptBtn.BackgroundTransparency = 1
            OptBtn.Text = tostring(opt)
            OptBtn.Font = Theme.FontRegular
            OptBtn.Parent = List
            registerColor(OptBtn, "TextColor3", "SubText")
            registerText(OptBtn, 12)
            OptBtn.MouseButton1Click:Connect(function()
                playClick()
                selected = opt
                Btn.Text = text .. ": " .. tostring(selected)
                open = false
                tween(Holder, {Size = UDim2.new(1, 0, 0, 34)})
                if callback then callback(selected) end
            end)
        end

        Btn.MouseButton1Click:Connect(function()
            playClick()
            open = not open
            tween(Holder, {Size = open and UDim2.new(1, 0, 0, 34 + #options * 26) or UDim2.new(1, 0, 0, 34)})
        end)

        return {Get = function() return selected end}
    end

    -----------------------------------------------
    -- NEW: Tab:AddTextbox(label, placeholder, default, callback)
    -- A labeled text input. Submits on Enter (focus lost with enter pressed).
    -- Works alongside any other control on the same tab.
    -----------------------------------------------
    function Tab:AddTextbox(label, placeholder, default, callback)
        local Holder = Instance.new("Frame")
        Holder.Size = UDim2.new(1, 0, 0, 48)
        Holder.LayoutOrder = nextOrder()
        Holder.Parent = Page
        registerColor(Holder, "BackgroundColor3", "ElementBG")
        corner(Holder, 8)

        local Label = Instance.new("TextLabel")
        Label.BackgroundTransparency = 1
        Label.Position = UDim2.new(0, 10, 0, 4)
        Label.Size = UDim2.new(1, -20, 0, 16)
        Label.Text = label or ""
        Label.Font = Theme.FontRegular
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = Holder
        registerColor(Label, "TextColor3", "SubText")
        registerText(Label, 12)

        local InputBox = Instance.new("TextBox")
        InputBox.Position = UDim2.new(0, 10, 0, 22)
        InputBox.Size = UDim2.new(1, -20, 0, 22)
        InputBox.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        InputBox.Text = default or ""
        InputBox.PlaceholderText = placeholder or ""
        InputBox.Font = Theme.FontRegular
        InputBox.ClearTextOnFocus = false
        InputBox.TextXAlignment = Enum.TextXAlignment.Left
        InputBox.Parent = Holder
        registerColor(InputBox, "TextColor3", "Text")
        registerColor(InputBox, "PlaceholderColor3", "SubText")
        registerText(InputBox, 13)
        corner(InputBox, 6)

        local InputPad = Instance.new("UIPadding")
        InputPad.PaddingLeft = UDim.new(0, 8)
        InputPad.PaddingRight = UDim.new(0, 8)
        InputPad.Parent = InputBox

        InputBox.FocusLost:Connect(function(enterPressed)
            playClick()
            if callback then callback(InputBox.Text, enterPressed) end
        end)

        return {
            Set = function(_, v) InputBox.Text = v end,
            Get = function() return InputBox.Text end
        }
    end

    return Tab
end

-------------------------------------------------
-- ACCESSIBILITY TAB (with save/load, reset, bubble/keybind/export controls)
-------------------------------------------------
function Library:AddAccessibilityTab()
    local AccTab = Library:CreateTab("Accessibility")

    AccTab:AddHeader("Appearance")
    local themeDropdown = AccTab:AddDropdown("Color Theme", Library:GetThemeNames(), function(selected)
        applyTheme(selected)
        UserSettings.Theme = selected
        SaveSettings()
    end)

    local uiScaleSlider = AccTab:AddSlider("UI Scale", 50, 150, UserSettings.UIScale, function(v)
        baseUIScale = v / 100
        UserSettings.UIScale = v
        recalcScale()
        SaveSettings()
    end)

    local textSizeSlider = AccTab:AddSlider("Text Size", 80, 150, UserSettings.TextSize, function(v)
        Theme.TextScale = v / 100
        UserSettings.TextSize = v
        for obj, base in pairs(TextRegistry) do
            if obj and obj.Parent then obj.TextSize = base * Theme.TextScale end
        end
        SaveSettings()
    end)

    local transparencySlider = AccTab:AddSlider("Window Transparency", 0, 90, UserSettings.Transparency, function(v)
        Theme.Transparency = v / 100
        UserSettings.Transparency = v
        if not Theme.HighContrast then Main.BackgroundTransparency = Theme.Transparency end
        SaveSettings()
    end)

    local highContrastToggle = AccTab:AddToggle("High Contrast Mode", UserSettings.HighContrast, function(state)
        Theme.HighContrast = state
        UserSettings.HighContrast = state
        if state then
            Main.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            Main.BackgroundTransparency = 0.1
        else
            Main.BackgroundColor3 = Theme.Background
            Main.BackgroundTransparency = Theme.Transparency
        end
        SaveSettings()
    end)

    AccTab:AddHeader("Comfort")
    local reducedMotionToggle = AccTab:AddToggle("Reduced Motion", UserSettings.ReducedMotion, function(state)
        Theme.ReducedMotion = state
        UserSettings.ReducedMotion = state
        SaveSettings()
    end)

    local dyslexiaToggle = AccTab:AddToggle("Dyslexia-Friendly Font", UserSettings.DyslexiaFont, function(state)
        UserSettings.DyslexiaFont = state
        for obj in pairs(TextRegistry) do
            if obj and obj.Parent then
                if state then
                    obj:SetAttribute("OrigFont", obj.Font.Name)
                    obj.Font = Enum.Font.Sans
                else
                    local orig = obj:GetAttribute("OrigFont")
                    obj.Font = (orig and Enum.Font[orig]) or Theme.FontRegular
                end
            end
        end
        SaveSettings()
    end)

    local colorblindToggle = AccTab:AddToggle("Colorblind Safe Palette", UserSettings.ColorblindSafe, function(state)
        UserSettings.ColorblindSafe = state
        if state then
            themeBeforeColorblind = currentThemeName
            applyTheme("ColorblindSafe")
        else
            applyTheme(themeBeforeColorblind)
        end
        SaveSettings()
    end)

    local reduceGlowToggle = AccTab:AddToggle("Reduce Glow / Outline Effects", UserSettings.ReduceGlow, function(state)
        UserSettings.ReduceGlow = state
        for _, e in ipairs(StrokeRegistry) do
            if e.obj and e.obj.Parent then
                e.obj.Thickness = state and 0 or e.base
            end
        end
        SaveSettings()
    end)

    AccTab:AddHeader("Interaction")
    local largerTargetsToggle = AccTab:AddToggle("Larger Click Targets", UserSettings.LargerTargets, function(state)
        largerTargetsBonus = state and 0.15 or 0
        UserSettings.LargerTargets = state
        recalcScale()
        SaveSettings()
    end)

    local soundsToggle = AccTab:AddToggle("Button Click Sounds", UserSettings.ClickSounds, function(state)
        soundsEnabled = state
        UserSettings.ClickSounds = state
        SaveSettings()
    end)

    local keybindToggle = AccTab:AddToggle("Enable Hotkey to Open/Close", UserSettings.KeybindEnabled, function(state)
        uiKeybindEnabled = state
        UserSettings.KeybindEnabled = state
        SaveSettings()
    end)

    AccTab:AddDropdown("Open/Close Keybind", {"RightControl", "RightShift", "Insert", "End", "F4", "Backslash"}, function(selected)
        currentKeybind = Enum.KeyCode[selected]
        UserSettings.OpenKeybind = selected
        SaveSettings()
    end)

    local autoCloseSlider = AccTab:AddSlider("Auto-Close After Inactivity (sec, 0 = off)", 0, 120, UserSettings.AutoClose, function(v)
        autoCloseSeconds = v
        UserSettings.AutoClose = v
        SaveSettings()
    end)

    AccTab:AddHeader("Bubble")
    local bubbleSizeSlider = AccTab:AddSlider("Bubble Size", 40, 90, UserSettings.BubbleSize, function(v)
        Bubble.Size = UDim2.new(0, v, 0, v)
        for _, c in ipairs(Bubble:GetChildren()) do
            if c:IsA("UICorner") then c.CornerRadius = UDim.new(0, v / 2) end
        end
        UserSettings.BubbleSize = v
        SaveSettings()
    end)

    local bubbleOpacitySlider = AccTab:AddSlider("Bubble Backing Darkness", 0, 100, 100, function(v)
        Bubble.BackgroundTransparency = 1 - (v / 100)
        SaveSettings()
    end)

    local edgeSnapToggle = AccTab:AddToggle("Snap Bubble to Screen Edge", UserSettings.EdgeSnap, function(state)
        bubbleEdgeSnap = state
        UserSettings.EdgeSnap = state
        SaveSettings()
    end)

    AccTab:AddButton("Reset Bubble Position", function()
        Bubble.Position = UDim2.new(0, 20, 0.5, -UserSettings.BubbleSize / 2)
        playClick()
    end)

    AccTab:AddHeader("Data")
    AccTab:AddButton("Export Config to Clipboard", function()
        local json = HttpService:JSONEncode(UserSettings)
        local ok = pcall(function()
            setclipboard(json)
        end)
        if ok then
            Library:Notify("Config Exported", "Settings copied to your clipboard.", 3)
        else
            Library:Notify("Export Failed", "Your executor doesn't support setclipboard.", 3)
        end
    end)

    AccTab:AddHeader("Reset")
    AccTab:AddButton("Reset to Defaults", function()
        for k, v in pairs(DEFAULT_SETTINGS) do
            UserSettings[k] = v
        end
        applyTheme(UserSettings.Theme)
        uiScaleSlider:Set(UserSettings.UIScale)
        textSizeSlider:Set(UserSettings.TextSize)
        transparencySlider:Set(UserSettings.Transparency)
        highContrastToggle:Set(UserSettings.HighContrast)
        reducedMotionToggle:Set(UserSettings.ReducedMotion)
        dyslexiaToggle:Set(UserSettings.DyslexiaFont)
        colorblindToggle:Set(UserSettings.ColorblindSafe)
        reduceGlowToggle:Set(UserSettings.ReduceGlow)
        largerTargetsToggle:Set(UserSettings.LargerTargets)
        soundsToggle:Set(UserSettings.ClickSounds)
        keybindToggle:Set(UserSettings.KeybindEnabled)
        autoCloseSlider:Set(UserSettings.AutoClose)
        bubbleSizeSlider:Set(UserSettings.BubbleSize)
        edgeSnapToggle:Set(UserSettings.EdgeSnap)

        baseUIScale = UserSettings.UIScale / 100
        largerTargetsBonus = UserSettings.LargerTargets and 0.15 or 0
        recalcScale()
        Theme.TextScale = UserSettings.TextSize / 100
        for obj, base in pairs(TextRegistry) do
            if obj and obj.Parent then obj.TextSize = base * Theme.TextScale end
        end
        Theme.Transparency = UserSettings.Transparency / 100
        if not Theme.HighContrast then Main.BackgroundTransparency = Theme.Transparency end
        Theme.ReducedMotion = UserSettings.ReducedMotion
        soundsEnabled = UserSettings.ClickSounds
        uiKeybindEnabled = UserSettings.KeybindEnabled
        currentKeybind = Enum.KeyCode[UserSettings.OpenKeybind] or Enum.KeyCode.RightControl
        autoCloseSeconds = UserSettings.AutoClose
        bubbleEdgeSnap = UserSettings.EdgeSnap
        SaveSettings()
        playClick()
    end)

    task.spawn(function()
        applyTheme(UserSettings.Theme)
        uiScaleSlider:Set(UserSettings.UIScale)
        textSizeSlider:Set(UserSettings.TextSize)
        transparencySlider:Set(UserSettings.Transparency)
        highContrastToggle:Set(UserSettings.HighContrast)
        reducedMotionToggle:Set(UserSettings.ReducedMotion)
        dyslexiaToggle:Set(UserSettings.DyslexiaFont)
        colorblindToggle:Set(UserSettings.ColorblindSafe)
        reduceGlowToggle:Set(UserSettings.ReduceGlow)
        largerTargetsToggle:Set(UserSettings.LargerTargets)
        soundsToggle:Set(UserSettings.ClickSounds)
        keybindToggle:Set(UserSettings.KeybindEnabled)
        autoCloseSlider:Set(UserSettings.AutoClose)
        bubbleSizeSlider:Set(UserSettings.BubbleSize)
        edgeSnapToggle:Set(UserSettings.EdgeSnap)

        baseUIScale = UserSettings.UIScale / 100
        largerTargetsBonus = UserSettings.LargerTargets and 0.15 or 0
        recalcScale()
        Theme.TextScale = UserSettings.TextSize / 100
        for obj, base in pairs(TextRegistry) do
            if obj and obj.Parent then obj.TextSize = base * Theme.TextScale end
        end
        Theme.Transparency = UserSettings.Transparency / 100
        if not Theme.HighContrast then Main.BackgroundTransparency = Theme.Transparency end
        Theme.ReducedMotion = UserSettings.ReducedMotion
        soundsEnabled = UserSettings.ClickSounds
        uiKeybindEnabled = UserSettings.KeybindEnabled
        autoCloseSeconds = UserSettings.AutoClose
        bubbleEdgeSnap = UserSettings.EdgeSnap
    end)

    return AccTab
end

-------------------------------------------------
-- Load settings & finalize
-------------------------------------------------
local loaded = LoadSettings()
if loaded then
    applyTheme(UserSettings.Theme)
    Theme.Transparency = UserSettings.Transparency / 100
    Main.BackgroundTransparency = Theme.Transparency
    baseUIScale = UserSettings.UIScale / 100
    largerTargetsBonus = UserSettings.LargerTargets and 0.15 or 0
    recalcScale()
    Theme.TextScale = UserSettings.TextSize / 100
    for obj, base in pairs(TextRegistry) do
        if obj and obj.Parent then obj.TextSize = base * Theme.TextScale end
    end
    if UserSettings.HighContrast then
        Main.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        Main.BackgroundTransparency = 0.1
    end
    Theme.ReducedMotion = UserSettings.ReducedMotion
    soundsEnabled = UserSettings.ClickSounds
    uiKeybindEnabled = UserSettings.KeybindEnabled
    currentKeybind = Enum.KeyCode[UserSettings.OpenKeybind] or Enum.KeyCode.RightControl
    autoCloseSeconds = UserSettings.AutoClose
    bubbleEdgeSnap = UserSettings.EdgeSnap
    Bubble.Size = UDim2.new(0, UserSettings.BubbleSize, 0, UserSettings.BubbleSize)
    if UserSettings.ReduceGlow then
        for _, e in ipairs(StrokeRegistry) do
            if e.obj and e.obj.Parent then
                e.obj.Thickness = 0
            end
        end
    end
end

Library:AddAccessibilityTab()

return Library
