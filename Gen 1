        local value = math.clamp(default or min, min, max)

        local Holder = Instance.new("Frame")
        Holder.Size = UDim2.new(1, 0, 0, 48)
        Holder.Parent = Page
        registerColor(Holder, "BackgroundColor3", "ElementBG")
        corner(Holder, 8)

        local Label = Instance.new("TextLabel")
        Label.BackgroundTransparency = 1
        Label.Position = UDim2.new(0, 10, 0, 4)
        Label.Size = UDim2.new(1, -70, 0, 18)
        Label.Text = text
        Label.Font = Theme.FontRegular
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = Holder
        registerColor(Label, "TextColor3", "Text")
        registerText(Label, 13)

        local ValueLabel = Instance.new("TextLabel")
        ValueLabel.BackgroundTransparency = 1
        ValueLabel.Position = UDim2.new(1, -60, 0, 4)
        ValueLabel.Size = UDim2.new(0, 50, 0, 18)
        ValueLabel.Text = tostring(value)
        ValueLabel.Font = Theme.Font
        ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
        ValueLabel.Parent = Holder
        registerColor(ValueLabel, "TextColor3", "Accent")
        registerText(ValueLabel, 13)

        local Track = Instance.new("Frame")
        Track.Position = UDim2.new(0, 10, 0, 28)
        Track.Size = UDim2.new(1, -20, 0, 8)
        Track.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        Track.Parent = Holder
        corner(Track, 4)

        local Fill = Instance.new("Frame")
        Fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        Fill.Parent = Track
        registerColor(Fill, "BackgroundColor3", "Accent")
        corner(Fill, 4)

        local Knob = Instance.new("TextButton")
        Knob.Size = UDim2.new(0, 16, 0, 16)
        Knob.Position = UDim2.new((value - min) / (max - min), -8, 0.5, -8)
        Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Knob.Text = ""
        Knob.Parent = Track
        corner(Knob, 8)

        local dragging = false
        Knob.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local rel = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                value = math.floor(min + rel * (max - min) + 0.5)
                Fill.Size = UDim2.new(rel, 0, 1, 0)
                Knob.Position = UDim2.new(rel, -8, 0.5, -8)
                ValueLabel.Text = tostring(value)
                if callback then callback(value) end
            end
        end)

        return {
            Set = function(_, v)
                value = math.clamp(v, min, max)
                local rel = (value - min) / (max - min)
                Fill.Size = UDim2.new(rel, 0, 1, 0)
                Knob.Position = UDim2.new(rel, -8, 0.5, -8)
                ValueLabel.Text = tostring(value)
                if callback then callback(value) end
            end,
            Get = function() return value end
        }
    end

    -----------------------------------------------
    function Tab:AddDropdown(text, options, callback)
        options = options or {}
        local open = false
        local selected = options[1]

        local Holder = Instance.new("Frame")
        Holder.Size = UDim2.new(1, 0, 0, 34)
        Holder.ClipsDescendants = true
        Holder.Parent = Page
        registerColor(Holder, "BackgroundColor3", "ElementBG")
        corner(Holder, 8)

        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(1, 0, 0, 34)
        Btn.BackgroundTransparency = 1
        Btn.Text = text .. ": " .. tostring(selected)
        Btn.Font = Theme.FontRegular
        Btn.Parent = Holder
        registerColor(Btn, "TextColor3", "Text")
        registerText(Btn, 13)

        local List = Instance.new("Frame")
        List.Position = UDim2.new(0, 0, 0, 34)
        List.Size = UDim2.new(1, 0, 0, #options * 26)
        List.BackgroundTransparency = 1
        List.Parent = Holder
        local ListLayout = Instance.new("UIListLayout")
        ListLayout.Parent = List

        for _, opt in ipairs(options) do
            local OptBtn = Instance.new("TextButton")
            OptBtn.Size = UDim2.new(1, 0, 0, 26)
            OptBtn.BackgroundTransparency = 1
            OptBtn.Text = tostring(opt)
            OptBtn.Font = Theme.FontRegular
            OptBtn.Parent = List
            registerColor(OptBtn, "TextColor3", "SubText")
            registerText(OptBtn, 12)
            OptBtn.MouseButton1Click:Connect(function()
                playClick()
                selected = opt
                Btn.Text = text .. ": " .. tostring(selected)
                open = false
                tween(Holder, {Size = UDim2.new(1, 0, 0, 34)})
                if callback then callback(selected) end
            end)
        end

        Btn.MouseButton1Click:Connect(function()
            playClick()
            open = not open
            tween(Holder, {Size = open and UDim2.new(1, 0, 0, 34 + #options * 26) or UDim2.new(1, 0, 0, 34)})
        end)

        return {Get = function() return selected end}
    end

    return Tab
end

-------------------------------------------------
-- ACCESSIBILITY TAB (with save/load & reset)
-------------------------------------------------
function Library:AddAccessibilityTab()
    local AccTab = Library:CreateTab("Accessibility")

    local controls = {}

    AccTab:AddHeader("Appearance")
    local themeDropdown = AccTab:AddDropdown("Color Theme", Library:GetThemeNames(), function(selected)
        applyTheme(selected)
        UserSettings.Theme = selected
        SaveSettings()
    end)
    themeDropdown:Get()

    local uiScaleSlider = AccTab:AddSlider("UI Scale", 50, 150, UserSettings.UIScale, function(v)
        baseUIScale = v / 100
        UserSettings.UIScale = v
        recalcScale()
        SaveSettings()
    end)
    controls.uiScaleSlider = uiScaleSlider

    local textSizeSlider = AccTab:AddSlider("Text Size", 80, 150, UserSettings.TextSize, function(v)
        Theme.TextScale = v / 100
        UserSettings.TextSize = v
        for obj, base in pairs(TextRegistry) do
            if obj and obj.Parent then obj.TextSize = base * Theme.TextScale end
        end
        SaveSettings()
    end)
    controls.textSizeSlider = textSizeSlider

    local transparencySlider = AccTab:AddSlider("Window Transparency", 0, 90, UserSettings.Transparency, function(v)
        Theme.Transparency = v / 100
        UserSettings.Transparency = v
        if not Theme.HighContrast then Main.BackgroundTransparency = Theme.Transparency end
        SaveSettings()
    end)
    controls.transparencySlider = transparencySlider

    local highContrastToggle = AccTab:AddToggle("High Contrast Mode", UserSettings.HighContrast, function(state)
        Theme.HighContrast = state
        UserSettings.HighContrast = state
        if state then
            Main.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            Main.BackgroundTransparency = 0.1
        else
            Main.BackgroundColor3 = Theme.Background
            Main.BackgroundTransparency = Theme.Transparency
        end
        SaveSettings()
    end)
    controls.highContrastToggle = highContrastToggle

    AccTab:AddHeader("Comfort")
    local reducedMotionToggle = AccTab:AddToggle("Reduced Motion", UserSettings.ReducedMotion, function(state)
        Theme.ReducedMotion = state
        UserSettings.ReducedMotion = state
        SaveSettings()
    end)
    controls.reducedMotionToggle = reducedMotionToggle

    local dyslexiaToggle = AccTab:AddToggle("Dyslexia-Friendly Font", UserSettings.DyslexiaFont, function(state)
        UserSettings.DyslexiaFont = state
        for obj in pairs(TextRegistry) do
            if obj and obj.Parent then
                if state then
                    obj:SetAttribute("OrigFont", obj.Font.Name)
                    obj.Font = Enum.Font.Sans
                else
                    local orig = obj:GetAttribute("OrigFont")
                    obj.Font = (orig and Enum.Font[orig]) or Theme.FontRegular
                end
            end
        end
        SaveSettings()
    end)
    controls.dyslexiaToggle = dyslexiaToggle

    local colorblindToggle = AccTab:AddToggle("Colorblind Safe Palette", UserSettings.ColorblindSafe, function(state)
        UserSettings.ColorblindSafe = state
        if state then
            themeBeforeColorblind = currentThemeName
            applyTheme("ColorblindSafe")
        else
            applyTheme(themeBeforeColorblind)
        end
        SaveSettings()
    end)
    controls.colorblindToggle = colorblindToggle

    local reduceGlowToggle = AccTab:AddToggle("Reduce Glow / Outline Effects", UserSettings.ReduceGlow, function(state)
        UserSettings.ReduceGlow = state
        for _, e in ipairs(StrokeRegistry) do
            if e.obj and e.obj.Parent then
                e.obj.Thickness = state and 0 or e.base
            end
        end
        SaveSettings()
    end)
    controls.reduceGlowToggle = reduceGlowToggle

    AccTab:AddHeader("Interaction")
    local largerTargetsToggle = AccTab:AddToggle("Larger Click Targets", UserSettings.LargerTargets, function(state)
        largerTargetsBonus = state and 0.15 or 0
        UserSettings.LargerTargets = state
        recalcScale()
        SaveSettings()
    end)
    controls.largerTargetsToggle = largerTargetsToggle

    local soundsToggle = AccTab:AddToggle("Button Click Sounds", UserSettings.ClickSounds, function(state)
        soundsEnabled = state
        UserSettings.ClickSounds = state
        SaveSettings()
    end)
    controls.soundsToggle = soundsToggle

    local keybindToggle = AccTab:AddToggle("Enable RightCtrl Hotkey to Open/Close", UserSettings.KeybindEnabled, function(state)
        uiKeybindEnabled = state
        UserSettings.KeybindEnabled = state
        SaveSettings()
    end)
    controls.keybindToggle = keybindToggle

    local autoCloseSlider = AccTab:AddSlider("Auto-Close After Inactivity (sec, 0 = off)", 0, 120, UserSettings.AutoClose, function(v)
        autoCloseSeconds = v
        UserSettings.AutoClose = v
        SaveSettings()
    end)
    controls.autoCloseSlider = autoCloseSlider

    AccTab:AddHeader("Reset")
    AccTab:AddButton("Reset to Defaults", function()
        for k, v in pairs(DEFAULT_SETTINGS) do
            UserSettings[k] = v
        end
        applyTheme(UserSettings.Theme)
        uiScaleSlider:Set(UserSettings.UIScale)
        textSizeSlider:Set(UserSettings.TextSize)
        transparencySlider:Set(UserSettings.Transparency)
        highContrastToggle:Set(UserSettings.HighContrast)
        reducedMotionToggle:Set(UserSettings.ReducedMotion)
        dyslexiaToggle:Set(UserSettings.DyslexiaFont)
        colorblindToggle:Set(UserSettings.ColorblindSafe)
        reduceGlowToggle:Set(UserSettings.ReduceGlow)
        largerTargetsToggle:Set(UserSettings.LargerTargets)
        soundsToggle:Set(UserSettings.ClickSounds)
        keybindToggle:Set(UserSettings.KeybindEnabled)
        autoCloseSlider:Set(UserSettings.AutoClose)

        baseUIScale = UserSettings.UIScale / 100
        largerTargetsBonus = UserSettings.LargerTargets and 0.15 or 0
        recalcScale()
        Theme.TextScale = UserSettings.TextSize / 100
        for obj, base in pairs(TextRegistry) do
            if obj and obj.Parent then obj.TextSize = base * Theme.TextScale end
        end
        Theme.Transparency = UserSettings.Transparency / 100
        if not Theme.HighContrast then Main.BackgroundTransparency = Theme.Transparency end
        Theme.ReducedMotion = UserSettings.ReducedMotion
        soundsEnabled = UserSettings.ClickSounds
        uiKeybindEnabled = UserSettings.KeybindEnabled
        autoCloseSeconds = UserSettings.AutoClose
        SaveSettings()
        playClick()
    end)

    task.spawn(function()
        applyTheme(UserSettings.Theme)
        uiScaleSlider:Set(UserSettings.UIScale)
        textSizeSlider:Set(UserSettings.TextSize)
        transparencySlider:Set(UserSettings.Transparency)
        highContrastToggle:Set(UserSettings.HighContrast)
        reducedMotionToggle:Set(UserSettings.ReducedMotion)
        dyslexiaToggle:Set(UserSettings.DyslexiaFont)
        colorblindToggle:Set(UserSettings.ColorblindSafe)
        reduceGlowToggle:Set(UserSettings.ReduceGlow)
        largerTargetsToggle:Set(UserSettings.LargerTargets)
        soundsToggle:Set(UserSettings.ClickSounds)
        keybindToggle:Set(UserSettings.KeybindEnabled)
        autoCloseSlider:Set(UserSettings.AutoClose)

        baseUIScale = UserSettings.UIScale / 100
        largerTargetsBonus = UserSettings.LargerTargets and 0.15 or 0
        recalcScale()
        Theme.TextScale = UserSettings.TextSize / 100
        for obj, base in pairs(TextRegistry) do
            if obj and obj.Parent then obj.TextSize = base * Theme.TextScale end
        end
        Theme.Transparency = UserSettings.Transparency / 100
        if not Theme.HighContrast then Main.BackgroundTransparency = Theme.Transparency end
        Theme.ReducedMotion = UserSettings.ReducedMotion
        soundsEnabled = UserSettings.ClickSounds
        uiKeybindEnabled = UserSettings.KeybindEnabled
        autoCloseSeconds = UserSettings.AutoClose
    end)

    return AccTab
end

-------------------------------------------------
-- Load settings & finalize
-------------------------------------------------
local loaded = LoadSettings()
if loaded then
    applyTheme(UserSettings.Theme)
    Theme.Transparency = UserSettings.Transparency / 100
    Main.BackgroundTransparency = Theme.Transparency
    baseUIScale = UserSettings.UIScale / 100
    largerTargetsBonus = UserSettings.LargerTargets and 0.15 or 0
    recalcScale()
    Theme.TextScale = UserSettings.TextSize / 100
    for obj, base in pairs(TextRegistry) do
        if obj and obj.Parent then obj.TextSize = base * Theme.TextScale end
    end
    if UserSettings.HighContrast then
        Main.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        Main.BackgroundTransparency = 0.1
    end
    Theme.ReducedMotion = UserSettings.ReducedMotion
    soundsEnabled = UserSettings.ClickSounds
    uiKeybindEnabled = UserSettings.KeybindEnabled
    autoCloseSeconds = UserSettings.AutoClose
    if UserSettings.ReduceGlow then
        for _, e in ipairs(StrokeRegistry) do
            if e.obj and e.obj.Parent then
                e.obj.Thickness = 0
            end
        end
    end
end

-- Add the Accessibility tab (built-in)
Library:AddAccessibilityTab()

return Library
