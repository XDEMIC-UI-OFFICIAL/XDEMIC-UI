-------------------------------------------------
local Theme = {
    Transparency    = UserSettings.Transparency / 100,
    Font            = Enum.Font.GothamBold,
    FontRegular     = Enum.Font.Gotham,
    ReducedMotion   = UserSettings.ReducedMotion,
    TextScale       = UserSettings.TextSize / 100,
    HighContrast    = UserSettings.HighContrast,
}
for k, v in pairs(ThemePresets[UserSettings.Theme] or ThemePresets.Dark) do Theme[k] = v end
local currentThemeName = UserSettings.Theme
local themeBeforeColorblind = currentThemeName

local TextRegistry   = {}
local ColorRegistry  = {}
local StrokeRegistry = {}
local soundsEnabled  = UserSettings.ClickSounds

local function registerText(obj, baseSize)
    TextRegistry[obj] = baseSize
    obj.TextSize = baseSize * Theme.TextScale
end

local function registerColor(obj, prop, role)
    table.insert(ColorRegistry, {obj = obj, prop = prop, role = role})
    obj[prop] = Theme[role]
    return obj
end

local function tween(obj, props, t)
    t = Theme.ReducedMotion and 0.01 or (t or 0.2)
    TweenService:Create(obj, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function stroke(parent, role, thickness)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1
    s.Parent = parent
    registerColor(s, "Color", role or "Accent")
    table.insert(StrokeRegistry, {obj = s, base = thickness or 1})
    return s
end

local function playClick()
    if not soundsEnabled then return end
    local snd = Instance.new("Sound")
    snd.SoundId = "rbxassetid://9083627113"
    snd.Volume = 0.4
    snd.Parent = SoundService
    snd:Play()
    game:GetService("Debris"):AddItem(snd, 2)
end

local function makeDraggable(handle, target)
    local dragging, dragStart, startPos = false, nil, nil
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-------------------------------------------------
-- APPLY THEME (live)
-------------------------------------------------
local function applyTheme(name)
    local preset = ThemePresets[name]
    if not preset then return end
    currentThemeName = name
    UserSettings.Theme = name
    for k, v in pairs(preset) do Theme[k] = v end
    for _, entry in ipairs(ColorRegistry) do
        if entry.obj and entry.obj.Parent then
            entry.obj[entry.prop] = Theme[entry.role]
        end
    end
    SaveSettings()
end

