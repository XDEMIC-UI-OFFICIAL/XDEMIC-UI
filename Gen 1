local function ShowNextNotification()
    if NotificationActive or #NotificationQueue == 0 then return end
    NotificationActive = true
    local data = table.remove(NotificationQueue, 1)
    
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 400, 0, 70)
    notif.Position = UDim2.new(0.5, -200, 0, 10)
    notif.BackgroundColor3 = Theme.Accent
    notif.BackgroundTransparency = 0.15
    notif.Parent = NotificationContainer
    corner(notif, 12)
    stroke(notif, "Text", 1)
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -20, 0, 20)
    title.Position = UDim2.new(0, 10, 0, 6)
    title.BackgroundTransparency = 1
    title.Font = Theme.Font
    title.TextColor3 = Theme.Text
    title.Text = data.title or ""
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = notif
    registerText(title, 16)
    
    local msg = Instance.new("TextLabel")
    msg.Size = UDim2.new(1, -20, 0, 30)
    msg.Position = UDim2.new(0, 10, 0, 28)
    msg.BackgroundTransparency = 1
    msg.Font = Theme.FontRegular
    msg.TextColor3 = Theme.SubText
    msg.Text = data.message or ""
    msg.TextXAlignment = Enum.TextXAlignment.Left
    msg.TextWrapped = true
    msg.Parent = notif
    registerText(msg, 13)
    
    notif.Position = UDim2.new(0.5, -200, 0, -80)
    tween(notif, {Position = UDim2.new(0.5, -200, 0, 10)}, 0.3)
    
    task.delay(data.duration or 3, function()
        tween(notif, {Position = UDim2.new(0.5, -200, 0, -80)}, 0.3)
        task.delay(0.3, function()
            notif:Destroy()
            NotificationActive = false
            ShowNextNotification()
        end)
    end)
end

function Library:Notify(title, message, duration)
    table.insert(NotificationQueue, {title = title, message = message, duration = duration or 3})
    if not NotificationActive then
        ShowNextNotification()
    end
end

